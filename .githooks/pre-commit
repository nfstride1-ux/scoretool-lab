#!/bin/sh
# Keep version.json in step with sw.js on every commit. If app files changed but sw.js didn't, bump it.
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qvE '^(version\.json|README\.md|tools/|\.githooks/|.*\.test\.js)$' && ! git diff --cached --name-only | grep -qx sw.js; then
  sh tools/bump.sh auto >/dev/null; git add sw.js index.html
fi
sh tools/write-version.sh; git add version.json
